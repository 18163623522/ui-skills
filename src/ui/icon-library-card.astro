---
import type { IconLibrary } from "../data/icon-libraries";
import IconLibraryActions from "./icon-library-actions";

type Props = IconLibrary;
const { name, description, stars, websiteUrl, githubUrl } = Astro.props as Props;
const githubOwner = new URL(githubUrl).pathname.split("/").filter(Boolean)[0] ?? "github";
const displayStars = stars?.replace(/^(\d+)\+$/, (_, value) => {
  const count = Number(value);
  return count < 1000 ? `${Math.floor(count / 100) * 100}+` : `${count}+`;
});
---

<article class="flex items-start gap-3 border-b border-line-default py-4 sm:items-center">
  <img
    src={`https://github.com/${githubOwner}.png?size=80`}
    alt=""
    aria-hidden="true"
    width="40"
    height="40"
    loading="lazy"
    decoding="async"
    class="size-10 shrink-0 rounded-xl border border-line-default bg-fill-subtle object-cover"
  />

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
      <h2 class="type-body-md truncate font-[450] text-content-primary">{name}</h2>
      {displayStars && <span class="type-body-sm inline-flex items-center gap-1 text-content-muted" aria-label={`${displayStars} GitHub stars`}><span aria-hidden="true" class="text-[11px]">★</span>{displayStars}</span>}
    </div>
    <p class="type-body-md truncate text-content-secondary">{description}</p>
  </div>

  <IconLibraryActions name={name} websiteUrl={websiteUrl} githubUrl={githubUrl} client:load />
</article>
